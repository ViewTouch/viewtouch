#!/bin/sh
# Before removal (DEB: "remove"; RPM: 0 = erase, 1 = upgrade). The data in
# /var/lib/viewtouch is kept.
case "$1" in
remove|0)
    if [ -d /run/systemd/system ]; then
        systemctl disable --now vtmodern.service vtmodern-kiosk.service >/dev/null 2>&1 || true
    fi
    ;;
esac
exit 0
