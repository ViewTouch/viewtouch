#!/bin/sh
# What the ViewTouch home screen (vtmodern --station) does as root, and only
# that: a sudo rule (/etc/sudoers.d/vtmodern-station, written by
# vtmodern-lockdown) lets the ViewTouch account run this one program. Every
# value is checked before use.
#
#   vtmodern-device setup ROLE NAME [--guest-display]   what this computer is, and its name
#   vtmodern-device forget                              not set up any more (asks again)
#   vtmodern-device wifi NAME                           join a Wi-Fi network (password on stdin)
#   vtmodern-device timezone ZONE                       e.g. America/New_York
#   vtmodern-device update                              install every update now
#   vtmodern-device update-usb                          install the newest ViewTouch package on a USB stick
#   vtmodern-device online-check                        is there a newer ViewTouch online? (last line: READY version | CURRENT version)
#   vtmodern-device online-update                       download it (signed), install it, and the newest tablet apps
#   vtmodern-device usb-open                            the USB sticks plugged in, read-only, for pictures
#   vtmodern-device ssh on|off                          remote help (SSH) on or off
#   vtmodern-device reboot | poweroff
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export LC_ALL=C.UTF-8

die() { echo "$*" >&2; exit 1; }
# FILE SIG: signed by the key this ViewTouch was built with, or one this
# computer's administrator added to /etc/viewtouch/trusted-keys/ (*.pem: a
# store's own builds, or another fork's).
signed_by_trusted() {
    for k in /usr/share/vtmodern/update-signing-key.pub.pem /etc/viewtouch/trusted-keys/*.pem; do
        [ -f "$k" ] || continue
        openssl pkeyutl -verify -pubin -inkey "$k" -rawin -in "$1" -sigfile "$2" >/dev/null 2>&1 && return 0
    done
    return 1
}
# Which ready-made package is this computer's: Debian 13 (and Raspberry Pi
# OS) and Ubuntu 26.04 each have their own, built on that system's Qt (one
# doesn't install on the other). Nothing: neither.
os_tag() {
    [ -r /etc/os-release ] || return 0
    (
        . /etc/os-release
        case "${ID:-}:${VERSION_ID:-}" in
            ubuntu:26.04) echo ubuntu26.04 ;;
            *:13) case " ${ID:-} ${ID_LIKE:-} " in *" debian "*) echo debian13 ;; esac ;;
        esac
    )
}
os_name() { ( . /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-this Linux}" ); }
# A package's version is this computer's: ~debian13 or ~ubuntu26.04 as this
# one is, or a build with neither (a store's own).
for_this_os() {
    case "$1" in
        *~"$2") return 0 ;;
        *~debian13|*~ubuntu26.04) return 1 ;;
        *) return 0 ;;
    esac
}
[ "$(id -u)" -eq 0 ] || die "Run this with sudo."

action=${1:-}
[ $# -gt 0 ] && shift

valid_name() {
    printf '%s' "$1" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9-]{0,62}$'
}

set_hostname() {
    name=$1
    old=$(hostname)
    [ "$old" = "$name" ] && return 0
    hostnamectl set-hostname "$name"
    # The 127.0.1.1 line, so sudo and others still find this computer by name.
    if grep -q '^127\.0\.1\.1' /etc/hosts; then
        sed -i "s/^127\.0\.1\.1.*/127.0.1.1\t$name/" /etc/hosts
    else
        printf '127.0.1.1\t%s\n' "$name" >> /etc/hosts
    fi
}

case "$action" in
setup)
    role=${1:-}
    name=${2:-}
    guest=${3:-}
    case "$role" in store|terminal|kitchen|selforder|timeclock) ;; *) die "Unknown role: $role" ;; esac
    valid_name "$name" || die "Use letters, numbers and dashes for the name."
    flags=
    [ "$guest" = "--guest-display" ] && flags=--guest-display
    set_hostname "$name"
    if [ "$role" = store ]; then
        VTM_SETUP_STATION=1 vtmodern-setup $flags store
    else
        VTM_SETUP_STATION=1 vtmodern-setup $flags "$role" auto "$name"
    fi
    echo "Set up as $role ($name)."
    ;;
forget)
    VTM_SETUP_STATION=1 vtmodern-setup forget
    ;;
wifi)
    ssid=${1:-}
    [ -n "$ssid" ] || die "Which network?"
    printf '%s' "$ssid" | grep -q '[[:cntrl:]]' && die "That network name can't be used."
    [ "$(printf '%s' "$ssid" | wc -c)" -le 32 ] || die "That network name is too long."
    IFS= read -r password || true
    printf '%s' "$password" | grep -q '[[:cntrl:]]' && die "That password can't be used."
    rfkill unblock wifi 2>/dev/null || true
    nmcli radio wifi on
    # The password goes into a file only root can read (never on a command line).
    file=/etc/NetworkManager/system-connections/vtmodern-wifi-$(printf '%s' "$ssid" | tr -c 'A-Za-z0-9-' '_').nmconnection
    umask 077
    {
        echo "[connection]"
        echo "id=$ssid"
        echo "uuid=$(cat /proc/sys/kernel/random/uuid)"
        echo "type=wifi"
        echo "autoconnect=true"
        echo
        echo "[wifi]"
        echo "mode=infrastructure"
        echo "ssid=$ssid"
        if [ -n "$password" ]; then
            echo
            echo "[wifi-security]"
            echo "key-mgmt=wpa-psk"
            echo "psk=$password"
        fi
        echo
        echo "[ipv4]"
        echo "method=auto"
        echo
        echo "[ipv6]"
        echo "method=auto"
    } > "$file"
    chmod 600 "$file"
    nmcli connection reload
    if nmcli --wait 30 connection up filename "$file"; then
        echo "Connected to $ssid."
    else
        rm -f "$file"
        nmcli connection reload
        die "Couldn't connect to $ssid (wrong password, or too far away)."
    fi
    ;;
timezone)
    zone=${1:-}
    timedatectl list-timezones | grep -qxF -- "$zone" || die "Unknown time zone: $zone"
    timedatectl set-timezone "$zone"
    echo "Time zone: $zone"
    ;;
update)
    export DEBIAN_FRONTEND=noninteractive
    echo "Looking for updates..."
    apt-get update
    apt-get -y -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold full-upgrade
    apt-get -y autoremove
    echo "Up to date."
    ;;
update-usb)
    export DEBIAN_FRONTEND=noninteractive
    mnt=/run/vtmodern-usb-update
    mkdir -p "$mnt"
    found=
    wrong=
    tag=$(os_tag)
    # Each partition of a USB drive, read-only, until one has a package for
    # this computer (a stick may hold the Debian and the Ubuntu one).
    for dev in $(lsblk -rpno NAME,TRAN,TYPE | awk '$2=="usb"{print $1}'); do
        for part in $(lsblk -rpno NAME,TYPE "$dev" | awk '$2=="part"{print $1}') "$dev"; do
            mount -o ro "$part" "$mnt" 2>/dev/null || continue
            pkg=
            for f in $(ls -t "$mnt"/vtmodern_*_"$(dpkg --print-architecture)"*.deb "$mnt"/*/vtmodern_*_"$(dpkg --print-architecture)"*.deb 2>/dev/null || true); do
                if for_this_os "$(dpkg-deb --field "$f" Version 2>/dev/null)" "$tag"; then
                    pkg=$f
                    break
                fi
                wrong=$(basename "$f")
            done
            if [ -n "$pkg" ]; then
                cp "$pkg" /tmp/vtmodern-update.deb
                rm -f /tmp/vtmodern-update.deb.sig
                [ -f "$pkg.sig" ] && cp "$pkg.sig" /tmp/vtmodern-update.deb.sig
                found=$(basename "$pkg")
            fi
            umount "$mnt"
            [ -n "$found" ] && break 2
        done
    done
    [ -n "$found" ] || [ -z "$wrong" ] || die "$wrong is for another Linux, not $(os_name): put this computer's package on the stick."
    [ -n "$found" ] || die "No ViewTouch package (vtmodern_....deb) on a USB stick."
    # Only a package signed by a trusted key (its .sig file beside it).
    [ -s /tmp/vtmodern-update.deb.sig ] || { rm -f /tmp/vtmodern-update.deb; die "$found has no signature (.sig file beside it): not installed."; }
    if ! signed_by_trusted /tmp/vtmodern-update.deb /tmp/vtmodern-update.deb.sig; then
        rm -f /tmp/vtmodern-update.deb /tmp/vtmodern-update.deb.sig
        die "$found isn't signed by ViewTouch (or was changed): not installed."
    fi
    echo "Installing $found..."
    apt-get install -y --allow-downgrades /tmp/vtmodern-update.deb
    rm -f /tmp/vtmodern-update.deb /tmp/vtmodern-update.deb.sig
    echo "Installed $found. Restart the computer to use it."
    ;;
online-check|online-update)
    # The release page: /etc/viewtouch/updates.conf (this computer's choice),
    # else the one this ViewTouch was built for (release-channel.conf). Its
    # latest.json and each file signed by a trusted key.
    url=
    for conf in /etc/viewtouch/updates.conf /usr/share/vtmodern/release-channel.conf; do
        [ -f "$conf" ] || continue
        grep -q '^url=' "$conf" || continue
        url=$(sed -n 's/^url=//p' "$conf" | tail -1 | tr -d '[:space:]')
        break
    done
    [ -n "$url" ] || die "Online updates aren't set up (no release page in /etc/viewtouch/updates.conf)."
    case "$url" in https://*) url=${url%/} ;; *) die "The release page must start with https:// ($url)." ;; esac
    work=/run/vtmodern-online
    rm -rf "$work"
    mkdir -p "$work"
    chmod 700 "$work"
    fetch() {   # name -> $work/name and $work/name.sig, checked
        curl -fsSL --retry 2 --max-time 600 -o "$work/$1" "$url/$1" || die "Couldn't download $1 from $url (no internet, or nothing published there)."
        curl -fsSL --retry 2 --max-time 60 -o "$work/$1.sig" "$url/$1.sig" || die "$1 has no signature online: not used."
        signed_by_trusted "$work/$1" "$work/$1.sig" ||
            die "$1 isn't signed by ViewTouch (or was changed on the way): not used."
    }
    build_of() { printf '%s' "$1" | sed -n 's/^[0-9]*\.[0-9]*\.\([0-9]*\).*/\1/p'; }
    echo "Looking at $url ..."
    fetch latest.json
    latest=$(sed -n 's/.*"version" *: *"\([0-9.]*\)".*/\1/p' "$work/latest.json" | head -1)
    [ -n "$latest" ] || die "latest.json says no version."
    installed=$(dpkg-query -W -f='${Version}' vtmodern 2>/dev/null || echo 0.0.0)
    have=$(build_of "$installed"); want=$(build_of "$latest")
    [ -n "$want" ] || die "latest.json: no build number in $latest."
    if [ "${have:-0}" -ge "$want" ]; then
        echo "CURRENT ${installed%%-*}"
        exit 0
    fi
    if [ "$action" = online-check ]; then
        echo "READY $latest ${installed%%-*}"
        exit 0
    fi
    arch=$(dpkg --print-architecture)
    tag=$(os_tag)
    [ -n "$tag" ] || die "No ready-made ViewTouch for $(os_name) online (there's one for Debian 13, Raspberry Pi OS and Ubuntu 26.04)."
    pkg=$(sed -n "s/.*\"$tag-$arch\" *: *\"\\([^\"]*\\)\".*/\\1/p" "$work/latest.json" | head -1)
    [ -n "$pkg" ] || die "No ready-made ViewTouch for this computer ($tag, $arch) online."
    printf '%s' "$pkg" | grep -Eq '^[A-Za-z0-9._-]+\.deb$' || die "latest.json: a strange file name."
    echo "Downloading ViewTouch $latest ..."
    fetch "$pkg"
    got=$(dpkg-deb --field "$work/$pkg" Version)
    [ "$(build_of "$got")" = "$want" ] || die "The package is $got, not $latest: not installed."
    case "$got" in *~"$tag") ;; *) die "The package is $got, not the one for $(os_name): not installed." ;; esac
    export DEBIAN_FRONTEND=noninteractive
    echo "Installing ViewTouch $latest ..."
    apt-get install -y "$work/$pkg"
    # The tablets' app too: the store offers it to tablets that are behind.
    updates=/var/lib/viewtouch/updates
    for abi in arm64-v8a armeabi-v7a; do
        apk=$(sed -n "s/.*\"android-$abi\" *: *\"\\([^\"]*\\)\".*/\\1/p" "$work/latest.json" | head -1)
        appbuild=$(sed -n "s/.*\"android-$abi-build\" *: *\"\\([0-9]*\\)\".*/\\1/p" "$work/latest.json" | head -1)
        [ -n "$apk" ] && [ -n "$appbuild" ] || continue
        printf '%s' "$apk" | grep -Eq '^[A-Za-z0-9._-]+\.apk$' || continue
        if (fetch "$apk"); then
            install -d -o vtpos -g vtpos "$updates" 2>/dev/null || install -d "$updates"
            rm -f "$updates"/ViewTouch-b*-"$abi".apk
            install -m 644 "$work/$apk" "$updates/ViewTouch-b$appbuild-$abi.apk"
            chown --reference="$updates" "$updates/ViewTouch-b$appbuild-$abi.apk" 2>/dev/null || true
            echo "Tablet app ($abi) ready for the tablets."
        fi
    done
    rm -rf "$work"
    echo "INSTALLED $latest"
    ;;
usb-open)
    # Each USB stick's partitions under /run/vtmodern-usb/<name>, read-only
    # and readable by ViewTouch (pictures for the store, a logo).
    base=/run/vtmodern-usb
    mkdir -p "$base"
    chmod 755 "$base"
    # Sticks pulled out since: let go of them.
    for d in "$base"/*; do
        [ -d "$d" ] || continue
        if mountpoint -q "$d"; then
            src=$(findmnt -no SOURCE "$d")
            [ -b "$src" ] || umount -l "$d"
        fi
        mountpoint -q "$d" || rmdir "$d" 2>/dev/null || true
    done
    count=0
    for dev in $(lsblk -rpno NAME,TRAN,TYPE | awk '$2=="usb" && $3=="disk"{print $1}'); do
        parts=$(lsblk -rpno NAME,TYPE "$dev" | awk '$2=="part"{print $1}')
        for part in ${parts:-$dev}; do
            fstype=$(lsblk -no FSTYPE "$part" | head -1)
            [ -n "$fstype" ] || continue
            if findmnt -rn -S "$part" >/dev/null; then
                count=$((count + 1))
                continue
            fi
            dir=$base/$(basename "$part")
            mkdir -p "$dir"
            case "$fstype" in
                vfat|exfat|ntfs|ntfs3) opts=ro,nosuid,nodev,noexec,umask=022 ;;
                *) opts=ro,nosuid,nodev,noexec ;;
            esac
            if mount -o "$opts" "$part" "$dir"; then
                count=$((count + 1))
            else
                rmdir "$dir" 2>/dev/null || true
            fi
        done
    done
    [ "$count" -gt 0 ] || die "No USB stick found. Plug one in and touch USB Stick again."
    echo "USB sticks open: $count"
    ;;
ssh)
    case "${1:-}" in
    on) systemctl enable --now ssh && echo "Remote help is on." ;;
    off) systemctl disable --now ssh && echo "Remote help is off." ;;
    *) die "on or off" ;;
    esac
    ;;
reboot)
    systemctl reboot
    ;;
poweroff)
    systemctl poweroff
    ;;
*)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 1
    ;;
esac
