# The home screen of a computer that is only for ViewTouch, on its screen at
# boot (vtmodern --station): it starts ViewTouch, starts it again if it stops
# by itself, and has the touch icons for the computer (network, updates,
# restart, reset...). Runs in the cage Wayland kiosk on tty1. Set up by
#   sudo vtmodern-lockdown
# which also turns the desktop off and locks the computer down.
[Unit]
Description=ViewTouch POS home screen
Documentation=file:///usr/share/doc/vtmodern/README.md
Wants=network-online.target
After=network-online.target systemd-user-sessions.service plymouth-quit-wait.service
After=getty@tty1.service
Conflicts=getty@tty1.service vtmodern-kiosk.service vtmodern.service

[Service]
Type=simple
User=viewtouch
Group=viewtouch
StateDirectory=viewtouch
StateDirectoryMode=0750
# Kept across restarts until the computer restarts: whether the screen
# draws in software (vtmodern-screen).
RuntimeDirectory=vtmodern-station
RuntimeDirectoryPreserve=yes
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=QT_QPA_PLATFORM=wayland
Environment=QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# To the ViewTouch screen once per boot, not at every restart: a home screen
# that can't start kept taking the screen from a technician's text login.
ExecStartPre=-+/bin/sh -c '[ -e /run/vtmodern-station-shown ] || { touch /run/vtmodern-station-shown; /usr/bin/chvt 1; }'
# -s keeps Ctrl+Alt+F2: a text login for a technician (it asks for a password).
ExecStart=/usr/libexec/vtmodern/vtmodern-screen /usr/bin/cage -d -s -- /usr/bin/vtmodern --station --kiosk --data-dir ${STATE_DIRECTORY} --config /etc/viewtouch/kiosk.conf
# Stopping (a restart, an update): ViewTouch closes first, saving, before the
# screen goes, so it isn't counted as a crash.
ExecStop=/bin/sh -c 'pkill -TERM -x -u "$$USER" vtmodern; for i in $$(seq 100); do pgrep -x -u "$$USER" vtmodern >/dev/null || exit 0; sleep 0.2; done'
Restart=always
# 2 seconds, then longer each time it fails, up to 30.
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
